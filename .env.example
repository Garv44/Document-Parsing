# Copy to .env and fill in.

# LLM provider: "anthropic" (Claude, default) or "gemini".
# LLM_MODEL defaults to claude-opus-5 / gemini-2.5-flash-lite for the chosen provider.
LLM_PROVIDER=anthropic
# LLM_MODEL=

# Key for the chosen provider
ANTHROPIC_API_KEY=
# GEMINI_API_KEY=               # or GOOGLE_API_KEY

# Leave empty to use a local SQLite file (docparse.db). For Postgres (see docker-compose.yml):
# DATABASE_URL=postgresql+asyncpg://docparse:docparse@localhost:5432/docparse

# Claude only:
# CLASSIFY_EFFORT=low
# EXTRACT_EFFORT=high
# LLM_FALLBACKS=true            # retry on a fallback model if the primary declines

# MAX_CONCURRENT_JOBS=3
# CLASSIFY_MIN_CONFIDENCE=0.6   # below this: processed but flagged, and a new type isn't saved to the registry
# FIELD_MIN_CONFIDENCE=0.7      # discovered types: fields below this are flagged for review
# AMOUNT_TOLERANCE=0.02
# PO_PRICE_TOLERANCE_PCT=2.0
# ANOMALY_MULTIPLIER=3.0        # flag totals above N x the vendor's median

# ERP: empty = built-in mock ERP table. Otherwise approved records are POSTed here as JSON.
# ERP_WEBHOOK_URL=
# ERP_API_KEY=
# AUTO_EXPORT_VALIDATED=false   # export clean documents without a human click
